# ============================================================
# EshKush TelegramAuth — Environment Configuration Template
# ============================================================
# Скопируй в .env.test или .env.production и заполни значения.
# Запуск: python -m app.bot (python-dotenv автоматически найдёт .env)
# Для выбора файла: cp .env.test .env && python -m app.bot

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Получи токен у @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
BOT_USERNAME=eshkush_bot

# ── Сервисы ───────────────────────────────────────────────────────────────────
# URL основного backend (Dart Shelf)
BACKEND_URL=http://localhost:8080
# URL frontend-приложения (для deep link возврата)
APP_URL=http://localhost:3000

# ── База данных бота (SQLite) ─────────────────────────────────────────────────
DATABASE_PATH=app/database.db

# ── Токен авторизации ─────────────────────────────────────────────────────────
TOKEN_EXPIRATION_MINUTES=10

# ── Flask сервер ──────────────────────────────────────────────────────────────
FLASK_PORT=5000

# ── Webhook (только для продакшна) ────────────────────────────────────────────
# В разработке бот работает через polling, webhook не нужен
WEBHOOK_HOST=
WEBHOOK_SSL_CERT=
