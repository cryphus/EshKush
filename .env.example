# EshKush — шаблон переменных окружения
# Скопируйте в .env и заполните реальными значениями.
# .env добавлен в .gitignore — не коммитить!

# ============================================================================
# PostgreSQL
# ============================================================================
POSTGRES_DB=flutter_auth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# ============================================================================
# Backend
# ============================================================================
DATABASE_URL=postgresql://postgres:CHANGE_ME_postgres_password@postgres:5432/flutter_auth
DB_HOST=postgres
DB_PORT=5432
DB_NAME=flutter_auth
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_postgres_password

# JWT — сгенерируйте случайные строки длиной 32+ символов
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_jwt_refresh_secret_min_32_chars
JWT_CLOCK_SKEW_SEC=10

PORT=3000
ENVIRONMENT=development

# CORS: список разрешённых origins через запятую (без пробелов)
# В production обязательно указать конкретные домены, не использовать *
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting (per IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1

# Логирование: debug|info|warn|error
LOG_LEVEL=info
LOG_JSON=true

# Максимальный размер тела запроса в байтах (default 10 MB)
MAX_REQUEST_BODY_BYTES=10485760

# Доверять proxy-заголовкам только от указанных IP (защита от spoofing X-Forwarded-For)
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=127.0.0.1,::1

# ============================================================================
# Redis
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECTION_TIMEOUT=5

# ============================================================================
# YooKassa — получить в личном кабинете https://yookassa.ru/
# ============================================================================
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=https://eshkush.app/payments/return
YOOKASSA_WEBHOOK_SECRET=CHANGE_ME_webhook_shared_secret

# Окно возвратов: сколько часов после создания заказа можно вернуть деньги
REFUND_WINDOW_HOURS=24

# ============================================================================
# OAuth — Яндекс
# Создать приложение: https://oauth.yandex.ru/
# Redirect URI: {OAUTH_CALLBACK_BASE_URL}/auth/yandex/callback
# ============================================================================
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ============================================================================
# OAuth — ВКонтакте
# Создать приложение: https://vk.com/apps?act=manage (тип: Web-сайт)
# Redirect URI: {OAUTH_CALLBACK_BASE_URL}/auth/vk/callback
# ============================================================================
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# ============================================================================
# OAuth — URLs
# ============================================================================
OAUTH_CALLBACK_BASE_URL=http://YOUR_SERVER_IP:3000
FRONTEND_URL=http://YOUR_SERVER_IP:3000
