# ============================================================
# EshKush — Environment Configuration Template
# ============================================================
# Скопируй в .env.test (для разработки) или .env.production (для продакшна)
# и заполни нужные значения.
# НЕ коммить .env.test / .env.production в git!
# Используй:
#   docker-compose --env-file .env.test up -d --build
#   docker-compose --env-file .env.production up -d --build
# ============================================================

# ── Окружение ─────────────────────────────────────────────────────────────────
ENVIRONMENT=test

# ── База данных ───────────────────────────────────────────────────────────────
# DB_HOST используется только при локальном запуске backend без Docker.
# Внутри docker-compose сервис всегда подключается к сервису "postgres".
DB_HOST=localhost
DB_PORT=5432
DB_EXTERNAL_PORT=5433        # внешний порт хоста → 5432 внутри контейнера
DB_NAME=flutter_auth
DB_USER=postgres
DB_PASSWORD=change_me

# ── JWT ───────────────────────────────────────────────────────────────────────
# Генерация: openssl rand -base64 48
JWT_SECRET=change_this_to_a_strong_random_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_to_another_strong_random_secret

# ── Backend сервер ────────────────────────────────────────────────────────────
PORT=8080

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis             # "redis" внутри Docker, "localhost" локально
REDIS_PORT=6379
REDIS_PASSWORD=              # оставить пустым или задать пароль

# ── CORS ──────────────────────────────────────────────────────────────────────
# Список разрешённых origin через запятую
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Логирование ───────────────────────────────────────────────────────────────
LOG_LEVEL=debug              # debug | info | warn | error
LOG_JSON=false               # false — текст, true — JSON-строки

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1

# ── Frontend / Flutter (передаются через --dart-define при сборке) ─────────────
# Эти значения НЕ читаются приложением в runtime — они вшиваются на этапе сборки.
# Используй scripts/build_test.sh или scripts/build_prod.sh.
API_BASE_URL=http://localhost:8080
TELEGRAM_API_URL=http://localhost:5000/api
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
BOT_USERNAME=eshkush_bot
IMAGE_BASE_URL=http://91.186.217.192
